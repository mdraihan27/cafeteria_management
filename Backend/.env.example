# Copy this file to ".env" and fill in real values for your machine.
# ".env" itself is never committed to git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cafeteria_app
DB_PASSWORD=CafeteriaApp@123
DB_NAME=cafeteria_db

# Any long random string works. Used to sign login tokens (JWT).
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480

APP_HOST=127.0.0.1
APP_PORT=8000

LOW_STOCK_THRESHOLD=10
